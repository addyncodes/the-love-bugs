import tkinter as tk
import random
from tkinter import messagebox
import winsound  # For sound effects (Windows only)

class ValentineApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Will You Be My Valentine?")
        self.root.geometry("500x400")
        self.root.configure(bg="lightpink")

        # Create the main message label
        self.message_label = tk.Label(root, text="Will you be my Valentine?", font=("Helvetica", 16), bg="lightpink")
        self.message_label.pack(pady=20)

        # Create an entry for the user's name
        self.name_entry = tk.Entry(root, width=30)
        self.name_entry.pack(pady=10)
        self.name_entry.insert(0, "Enter your name")

        # Create the YES button
        self.yes_button = tk.Button(root, text="YES", command=self.show_love_message, width=10, height=2)
        self.yes_button.pack(side=tk.LEFT, padx=50)

        # Create the NO button
        self.no_button = tk.Button(root, text="NO", command=self.no_button_action, width=10, height=2)
        self.no_button.pack(side=tk.RIGHT, padx=50)

        # Bind the motion event to the NO button
        self.no_button.bind("<Enter>", self.move_no_button)

    def move_no_button(self, event):
        # Change background color when hovering over NO button
        self.root.configure(bg=random.choice(["lightpink", "lightblue", "lightgreen", "lightyellow"]))

        # Randomly move the NO button to a new position
        new_x = random.randint(50, 400)
        new_y = random.randint(100, 300)
        self.no_button.place(x=new_x, y=new_y)

    def show_love_message(self):
        # Play sound effect (if you have a sound file, uncomment the line below)
        # winsound.PlaySound("yes_sound.wav", winsound.SND_FILENAME)

        # Create a new window for the love message
        love_window = tk.Toplevel(self.root)
        love_window.title("Love Message")
        
        # Get the user's name
        name = self.name_entry.get() if self.name_entry.get() != "Enter your name" else "My Love"
        
        # Personalize your message here
        personalized_message = f"Happy Valentine's Day, {name}! You are my everything! ❤️"
        
        # Create a label to display the message
        message_label = tk.Label(love_window, text=personalized_message, font=("Helvetica", 16))
        message_label.pack(pady=20)

        # Create a button to close the love message window
        close_button = tk.Button(love_window, text="Close", command=love_window.destroy)
        close_button.pack(pady=10)

    def no_button_action(self):
        # Play sound effect (if you have a sound file, uncomment the line below)
        # winsound.PlaySound("no_sound.wav", winsound.SND_FILENAME)

        # Show a message if NO is pressed
        messagebox.showinfo("Oops!", "You can't say NO! 😄")

# Create the main application window
root = tk.Tk()
app = ValentineApp(root)

# Run the application
root.mainloop()
